NEXT_PUBLIC_SITE_URL=http://localhost:3000
CONTACT_EMAIL=genumsolutions@gmail.com

# Supabase (Project Settings -> API in the Supabase dashboard)
# NOTE: use the bare project URL - do not append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Google sign-in/up: no code env vars needed - enable the provider in
# Supabase dashboard -> Authentication -> Providers -> Google, using an
# OAuth client from https://console.cloud.google.com/apis/credentials with
# authorized redirect URI https://<project-ref>.supabase.co/auth/v1/callback

# Email (optional - contact form falls back gracefully)
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=GENUM website <onboarding@resend.dev>

# Payments (optional - buttons degrade gracefully when unset)

# eSewa (https://developer.esewa.com.np - UAT: product code EPAYTEST, secret from the docs)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace_me
ESEWA_BASE_URL=https://uat.esewa.com.np

# Khalti (https://dashboard.khalti.com - merchant API keys; test base https://a.khalti.com/api/v2)
KHALTI_SECRET_KEY=replace_me
KHALTI_BASE_URL=https://a.khalti.com/api/v2
